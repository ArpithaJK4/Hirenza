# ── Copy to .env (local) and add the same keys as GitHub Actions secrets (cloud). Never commit .env.

# Core
APP_ENV=development
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Laptop mode (default, nothing to install): a local SQLite file. scripts/start-local.sh sets this for you.
#   DATABASE_URL=sqlite:////absolute/path/to/Hirenza/backend/data/hirenza.db
# Optional cloud mode: Neon Postgres connection string (postgresql://...?sslmode=require)
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
ALLOW_REGISTRATION=false
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# Confidentiality guardrails (HARD blocks). Comma-separated.
# Jobs from these companies are never shown/applied to; their employees are never contacted.
CURRENT_EMPLOYER_NAMES=
CURRENT_EMPLOYER_DOMAINS=

# Email notifications (Gmail: enable 2FA, then create an App Password at
# https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL_TO=
MAX_ALERTS_PER_RUN=15

# Optional Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LinkedIn + Naukri job-alert emails (read-only IMAP; same Gmail App Password works)
GMAIL_IMAP_USER=
GMAIL_IMAP_APP_PASSWORD=
GMAIL_ALERT_LOOKBACK_DAYS=7

# Optional job APIs (free tiers)
# https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRIES=in,gb,us,de,nl,sg,ca
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=

# Discovery tuning
HTTP_TIMEOUT_SECONDS=20
ATS_CONCURRENCY=8

# LLM (optional — rules/templates work without it). Token-smart: only top-N jobs, cached, daily cap.
# anthropic | ollama | none
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
# set claude-haiku-5-5 for the cheapest option
LLM_MODEL=claude-opus-5-5
OLLAMA_BASE_URL=http://localhost:11434
# free, local
OLLAMA_MODEL=llama3.1
LLM_DAILY_CALL_LIMIT=150
LLM_RERANK_TOP_N=20

# Your contact details for autofill + cover letters (env only — never committed)
CANDIDATE_FULL_NAME=
CANDIDATE_EMAIL=
CANDIDATE_PHONE=
CANDIDATE_LINKEDIN_URL=
CANDIDATE_GITHUB_URL=
CANDIDATE_LOCATION="Bengaluru, India"
FOLLOW_UP_DAYS=5

# Auto-apply: PUBLIC company forms only (Greenhouse/Lever/Ashby). Never Naukri/LinkedIn/Indeed.
# Start with DRY_RUN=true (fills + screenshots, never submits). Requires:
#   backend/.venv/bin/pip install -r backend/requirements-autofill.txt && backend/.venv/bin/playwright install chromium
AUTO_APPLY_ENABLED=false
AUTO_APPLY_DRY_RUN=true
AUTO_APPLY_MIN_SCORE=80
AUTO_APPLY_DAILY_CAP=10
AUTO_APPLY_COUNTRIES=India,Worldwide
# Answers used on forms. Anything left empty -> that question goes to your Review Queue (never guessed).
CANDIDATE_CURRENT_COMPANY=
CANDIDATE_PAST_EMPLOYERS=
CANDIDATE_YEARS_EXPERIENCE=2
CANDIDATE_NOTICE_PERIOD=
CANDIDATE_CURRENT_CTC=
CANDIDATE_EXPECTED_CTC=
# yes | no
CANDIDATE_WILLING_TO_RELOCATE=
CANDIDATE_NEEDS_SPONSORSHIP_ABROAD=yes
CANDIDATE_DEGREE="Master's"
